# Copie para .env.local (não commitar)
# Domínio canônico
VITE_SITE_URL=https://tupi.video

# Google Tag Manager (preferido — dispara GA4/Pixel de dentro do container)
VITE_GTM_ID=GTM-P4DGCZTG

# Google Analytics 4 — só é usado se VITE_GTM_ID estiver vazio.
# Com GTM ativo, configure a tag GA4 no container com este ID:
VITE_GA4_ID=G-8F34Q1Y9SS

# Opcional
VITE_META_PIXEL_ID=
